# ===========================================================================
#  Variables de entorno. Copia este archivo a .env y rellena los valores.
#  NUNCA subas el .env al repositorio: ya está en .gitignore.
# ===========================================================================

# --------------------------------------------------------------- Aplicación
APP_NAME="Forja"
APP_URL="https://tu-dominio.com/ruta-de-la-app"
# Prefijo de la app dentro del dominio, sin barra final.
# Vacío si la app vive en la raíz del dominio.
APP_BASE_PATH="/demo-aplicaciones/ai-skills"
APP_DEBUG=false
APP_TIMEZONE="America/Guayaquil"

# Sal usada para anonimizar las direcciones IP en la bitácora.
# Genera una propia:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY="cambia-esto-por-una-cadena-larga-y-aleatoria"

# ------------------------------------------------------------ Base de datos
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="ai_skills"
DB_USER=""
DB_PASS=""

# ------------------------------------------------------------------- Correo
MAIL_ENABLED=true
MAIL_ENDPOINT="https://api.tu-proveedor.com/api/email/send"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="no-reply@tu-dominio.com"

# Destinatario de los avisos de nuevos envíos.
ADMIN_EMAIL="admin@tu-dominio.com"

# ------------------------------------------------------------------ Límites
# Tamaño máximo de archivo adjunto en bytes (5 MB por defecto).
UPLOAD_MAX_BYTES=5242880

# Plataformas de agente que se ofrecen como compatibilidad.
SKILL_COMPATIBILITY="OpenClaw,Claude,ChatGPT,Gemini,Otros"
